# Copia este archivo como ".env" y completa los valores. NUNCA subas el .env a GitHub.

PORT=3000

# Cadena de conexión de MongoDB (Atlas o local)
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/itspeak

# Clave larga y aleatoria para firmar los tokens del admin.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga

# Sitios que pueden llamar a la API (separados por comas, sin "/" al final)
CORS_ORIGIN=http://localhost:5173,https://TU_USUARIO.github.io

# ---- Inteligencia artificial ----
# Proveedor: "gemini" (tiene capa gratuita) o "anthropic"
AI_PROVIDER=gemini

# Gemini: clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Revisa en AI Studio qué modelo gratuito está vigente y cámbialo aquí si hace falta
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (de pago): solo si usas AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
