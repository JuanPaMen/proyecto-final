# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

PORT=4000

# Cadena de conexión de MongoDB (local o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tienda_ropa

# Texto largo y aleatorio para firmar los tokens de login
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

# Orígenes del frontend permitidos por CORS (separados por coma).
# Con GitHub Pages el origen es solo el dominio, sin la ruta del repo:
FRONTEND_URL=http://localhost:5173,https://JuanPaMen.github.io

# Admin inicial (lo crea `npm run seed`)
ADMIN_EMAIL=admin@mitienda.com
ADMIN_PASSWORD=cambia_esta_clave

# IA (chatbot)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
BRAND_NAME=Mi Tienda
BRAND_TONE=cercano, juvenil, amable y con buena energía
