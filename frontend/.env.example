# Copia este archivo como ".env" para desarrollo local (opcional).
# En producción estas variables se configuran en GitHub (Settings > Variables).

# URL del backend desplegado (sin "/" al final). Si no existe, usa http://localhost:3000
VITE_API_URL=http://localhost:3000

# WhatsApp de la tienda, con código de país y sin "+" ni espacios (ej: 573001234567)
VITE_WHATSAPP=
